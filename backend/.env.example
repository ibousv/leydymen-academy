# ============================================================================
# LEYDYMEN ACADEMY - Configuration d'environnement
# ============================================================================
# IMPORTANT: Copier ce fichier en .env et adapter les valeurs à votre environnement
# Ne JAMAIS commiter .env avec les secrets réels (déjà dans .gitignore)
# ============================================================================

# ============================================================================
# CONFIGURATION MYSQL
# ============================================================================
# Identifiants de connexion MySQL utilisés par les conteneurs Docker

# Mot de passe root MySQL (admin total)
# ATTENTION: À modifier en production
MYSQL_ROOT_PASSWORD=root_password

# Nom de la base de données à créer automatiquement
MYSQL_DATABASE=leydymen_db

# Utilisateur MySQL spécifique pour l'application
MYSQL_USER=leydymen_user

# Mot de passe de l'utilisateur application
# ATTENTION: À modifier en production
MYSQL_PASSWORD=leydymen_pass

# ============================================================================
# CONFIGURATION APPLICATION SPRING BOOT
# ============================================================================

# Profil Spring Boot actif (dev/prod)
# - dev: Connexion MySQL via localhost (développement local)
# - prod: Optimisations de production
SPRING_PROFILES_ACTIVE=dev

# Clé secrète JWT pour signer les tokens
# OBLIGATOIRE: Doit être une chaîne d'au minimum 256 caractères pour sécurité HS256
# Générer une clé: openssl rand -hex 128 ou python3 -c "import secrets; print(secrets.token_hex(128))"
# ATTENTION: À modifier en production avec une vraie clé sécurisée
APP_JWT_SECRET=your-secret-key-min-256-characters-long-for-hs256-algorithm-security

# Durée de validité du token JWT en millisecondes
# 86400000 = 24 heures (24 * 60 * 60 * 1000)
APP_JWT_EXPIRATION_MS=86400000

# Durée de validité du refresh token en millisecondes
# 604800000 = 7 jours (7 * 24 * 60 * 60 * 1000)
APP_JWT_REFRESH_EXPIRATION_MS=604800000

# ============================================================================
# CONFIGURATION LOGGING
# ============================================================================

# Niveau de log global (DEBUG, INFO, WARN, ERROR)
# INFO recommandé en production, DEBUG en développement
LOGGING_LEVEL_ROOT=INFO

# Niveau de log spécifique pour l'application LEYDYMEN
# DEBUG en développement pour plus de détails, INFO en production
LOGGING_LEVEL_COM_LEYDYMEN=DEBUG

# ============================================================================
# CONFIGURATION PORTS
# ============================================================================

# Port d'accès au backend Spring Boot sur votre machine hôte
# Format: port_hote:port_conteneur (défini dans docker-compose)
BACKEND_PORT=8080

# Port d'accès à MySQL sur votre machine hôte
MYSQL_PORT=3306

# Port d'accès à phpMyAdmin (interface graphique MySQL)
PHPMYADMIN_PORT=8081

# ============================================================================
# NOTES D'UTILISATION
# ============================================================================
# 
# 1. Développement local:
#    - Copier .env.example en .env
#    - Adapter les variables (surtout APP_JWT_SECRET)
#    - Lancer: docker-compose up -d
#
# 2. Production:
#    - Générer une clé JWT sécurisée
#    - Changer tous les mots de passe (MYSQL_ROOT_PASSWORD, MYSQL_PASSWORD)
#    - Passer LOGGING_LEVEL_COM_LEYDYMEN à INFO
#    - Passer SPRING_PROFILES_ACTIVE à prod
#
# 3. Accès aux services:
#    - Backend API: http://localhost:8080
#    - Swagger UI: http://localhost:8080/swagger-ui.html
#    - phpMyAdmin: http://localhost:8081
#    - MySQL: localhost:3306
#
# ============================================================================
